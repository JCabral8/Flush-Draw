{
  "name": "poker-golf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Every golf shot is a poker hand.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "artifact": "vite build && tsx tools/make-artifact.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "sim": "tsx tools/cli.ts",
    "simulate": "tsx tools/simulate.ts",
    "build:ios": "vite build && cap sync ios",
    "build:android": "vite build && cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "playwright-core": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "pixi.js": "^8.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tone": "^15.1.22",
    "zustand": "^5.0.14"
  }
}